# ---------------------------------------------------------------------------
# Client-readable config (inlined into the app bundle by Expo). NON-secret only.
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Native Google Sign-In (client-safe OAuth client ids — these are public by design).
# Leave blank to disable native Google: the app falls back to the in-app browser OAuth
# flow automatically (src/features/auth/social.ts). To enable native Google:
#   1. Google Cloud project "LYSM" → create OAuth client ids: iOS (bundle com.lysm.app) and
#      Android (package com.lysm.app + the signing SHA-1s). The existing Web client stays.
#   2. Fill WEB_CLIENT_ID (the existing Web client; used on both iOS & Android) and IOS_CLIENT_ID.
#   3. Set IOS_URL_SCHEME to the iOS client's REVERSED client id
#      (e.g. com.googleusercontent.apps.1234-abcd) so the config plugin is wired.
#   4. Supabase Auth → Google: add the iOS client id after the Web one in "Client IDs", and enable
#      "Skip nonce check" (required for iOS native id tokens).
#   5. Edge Function secret GOOGLE_OAUTH_CLIENT_IDS (below) = "<web id>,<iOS id>": the account
#      linking pre-check (account-link) refuses native Google tokens until it is set.
#   6. Rebuild (adds the native module).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Payments use App Store / Google Play in-app purchases (see src/features/iap). No
# client payment keys are needed. Product ids are set in src/features/iap/products.ts
# once the store products exist.

# Build variant: development | staging | production
# (maps to the store environment: production -> production, dev/staging -> sandbox)
APP_VARIANT=development

# EAS project id (for builds); fill after `eas init`.
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets — DO NOT put these here or in the bundle. They belong in
# Supabase Edge Function secrets / EAS secrets and are used only server-side
# (build prompt §6). Listed for reference:
#   AI_API_KEY                 (AI summaries — OpenRouter or OpenAI key)
#   AI_BASE_URL                (default https://openrouter.ai/api/v1; or OpenAI's)
#   AI_MODEL                   (default openai/gpt-4o-mini)
#   RESEND_API_KEY             (transactional email — Edge Function)
#   RESEND_FROM                (verified sender, e.g. "InnerCircle <hi@yourdomain>")
#   GOOGLE_OAUTH_CLIENT_IDS    (Sign-in & Security + account-link: comma-separated Google OAuth client
#                               ids whose id tokens are accepted: the Web client id, plus the iOS
#                               client id. Unset = only the browser Google fallback works)
#   APPLE_CLIENT_ID            (optional; Sign in with Apple audience, default com.lysm.app)
#   In-app purchase server validation (future validate-purchase Edge Function):
#   APPLE_SHARED_SECRET / APP_STORE_SERVER_API_KEY   (Apple receipt / server API)
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON                 (Play Developer API verification)
#   EXPO_ACCESS_TOKEN          (OPTIONAL — only if Expo "enhanced security for push" is enabled)
#   (Push uses Expo's push service — NO FCM/APNs keys on the server. Android needs an
#    FCM v1 service account uploaded to EAS via `eas credentials`; iOS APNs is managed
#    by EAS. See supabase/functions/README.md → send-push.)
#   SUPABASE_SERVICE_ROLE_KEY  (Edge Functions only — NEVER on the client)
# ---------------------------------------------------------------------------
